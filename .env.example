# Grafana Cloud APM Configuration
# Replace with your actual Grafana Cloud credentials

# Your Grafana Cloud instance ID
GRAFANA_CLOUD_INSTANCE_ID="your-instance-id"

# Your Grafana Cloud API key (with push permissions)
GRAFANA_CLOUD_API_KEY="your-api-key"

# Environment (development, staging, production)
ENVIRONMENT="development"

# OpenTelemetry settings
OTEL_ENABLE_TRACING="true"
OTEL_ENABLE_METRICS="true"
OTEL_ENABLE_LOGGING="true"
OTEL_ENABLE_CONSOLE="false"
OTEL_TRACE_SAMPLE_RATE="1.0"

# Optional: Custom OTLP endpoints (auto-generated if not set)
# GRAFANA_CLOUD_OTLP_ENDPOINT="https://otlp-gateway-prod-us-central-0.grafana.net/otlp"
# GRAFANA_CLOUD_METRICS_ENDPOINT="https://prometheus-prod-us-central-0.grafana.net/api/prom/push"
# GRAFANA_CLOUD_LOGS_ENDPOINT="https://logs-prod-us-central-0.grafana.net/loki/api/v1/push"

# AetherTerm specific settings
AETHERTERM_DEBUG="true"
AETHERTERM_HOST="localhost"
AETHERTERM_PORT="57575"
AETHERTERM_UNSECURE="true"

# AI Service Configuration
AI_PROVIDER=lmstudio
AI_MODEL=default
LMSTUDIO_URL=http://192.168.210.218:1234

# Alternative providers (uncomment to use)
# AI_PROVIDER=anthropic
# AI_API_KEY=your-api-key-here
# AI_MODEL=claude-3-5-sonnet-20241022

# AI_PROVIDER=mock  # For testing without real AI service