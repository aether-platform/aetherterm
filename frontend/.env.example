# OpenTelemetry Configuration for Grafana Cloud
VITE_OTEL_SERVICE_NAME=aetherterm-frontend
VITE_APP_VERSION=0.0.1
VITE_ENVIRONMENT=development
VITE_GRAFANA_CLOUD_OTLP_ENDPOINT=https://otlp-gateway-prod-ap-northeast-0.grafana.net/otlp
VITE_GRAFANA_CLOUD_API_KEY=your-grafana-cloud-api-key-here
VITE_OTEL_TRACE_SAMPLE_RATE=1.0